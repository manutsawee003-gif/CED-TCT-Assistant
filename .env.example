PORT=3001
DATASET_PATH=./data/Dataset_CED-TCT1_การรับสมัคร.xlsx
DEBUG_CHAT=false
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TIMEOUT_MS=7000
# Retrieval calibration: inspect DEBUG_CHAT candidates before changing these.
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MIN_EVIDENCE=0.19
RETRIEVAL_AMBIGUITY_MARGIN=0.045
RETRIEVAL_ENTITY_WEIGHT=0.30
RETRIEVAL_SEMANTIC_WEIGHT=0.28
RETRIEVAL_ANSWER_SEMANTIC_WEIGHT=0.08
RETRIEVAL_LEXICAL_WEIGHT=0.16
RETRIEVAL_FUZZY_WEIGHT=0.07
RETRIEVAL_INTENT_WEIGHT=0.07
RETRIEVAL_CATEGORY_WEIGHT=0.04
RETRIEVAL_EXPANSION_WEIGHT=0.04
RETRIEVAL_CONFLICT_PENALTY=0.50
BM25_K1=1.2
BM25_B=0.75
RETRIEVAL_RRF_K=60
# Local multilingual dense embedding. The model and Dataset vectors are cached under cache/.
DENSE_MODEL=Xenova/multilingual-e5-small
DENSE_BATCH_SIZE=16
DENSE_QUERY_TIMEOUT_MS=1500
# Set true only on a host with enough CPU/RAM. BM25+TF-IDF+fuzzy remain active either way.
DENSE_ENABLED=false
# Profile generation is an offline, checkpointed Typhoon job; use a small value to trial it.
PROFILE_LIMIT=1249
AI_RERANK_MAX_GAP=0.12
AI_RERANK_BLEND=0.25
MULTI_RECORD_SCORE_WINDOW=0.10
MAX_MULTI_RECORDS=3
